# ============================================================
# Amazon バイヤーへの取扱説明書自動送信 設定
# ============================================================

# Amazon SP-API 認証情報
# 取得方法: Seller Central → アプリと連携 → アプリの開発
SP_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxx
SP_LWA_CLIENT_SECRET=your-lwa-client-secret
SP_LWA_REFRESH_TOKEN=Atzr|your-refresh-token

# セラーID: Seller Central → アカウント情報 → セラートークン
SP_SELLER_ID=AXXXXXXXXXXXXX

# マーケットプレイスID（日本: A1VC38T7YXB528）
SP_MARKETPLACE_ID=A1VC38T7YXB528

# 対象商品のASIN（Seller Central → 在庫管理 で確認）
PRODUCT_ASIN=B0XXXXXXXXX

# OneDrive 共有リンク（取扱説明書PDF）
# OneDrive → ファイルを右クリック → リンクのコピー → 「リンクを知っているすべてのユーザー」
MANUAL_URL=https://1drv.ms/b/s!XXXXXXXXXXXXXXXXXXXX

# 送信済み注文記録ファイル（デフォルト: sent_orders.json）
STATE_FILE=sent_orders.json

# ============================================================
# Gmail IMAP 設定
# Gmail の設定 → 転送と POP/IMAP → IMAP を有効化してください
# Google アカウント → セキュリティ → 2段階認証 → アプリパスワード で発行した16桁を設定
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password-16chars

# 領収書 PDF の保存先ディレクトリ（デフォルト: receipts）
RECEIPT_OUTPUT_DIR=receipts

# 取得対象の日数（デフォルト: 30日分）
DAYS_BACK=30
