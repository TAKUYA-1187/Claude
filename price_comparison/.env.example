# === Amazon PA-API 5.0 ===
# https://affiliate.amazon.co.jp/assoc_credentials/home
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.co.jp
AMAZON_REGION=us-west-2

# === 楽天市場 API ===
# https://webservice.rakuten.co.jp/
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=

# === Yahoo!ショッピング API ===
# https://developer.yahoo.co.jp/webapi/shopping/
YAHOO_APP_ID=

# === OneDrive 共有フォルダ (買取スキャナーCSV 配置先) ===
# 「リンクを知っている全員」で共有して得られる https://1drv.ms/f/... のURLをそのまま設定
# 空文字なら data/input/*.csv をそのまま使う (OneDrive取得をスキップ)
ONEDRIVE_SHARE_URL=

# === 対象にする買取店 (カンマ区切り) ===
# 列名に含まれる店舗名でマッチ。指定店舗のいずれかで買取価格が付いた商品だけを抽出
ENABLED_SHOPS=買取商店,ウィキ

# === JAN 収集 (--collect 実行時) ===
# 収集に使うキーワード (カンマ区切り)。売れ筋順に COLLECT_PAGES ページずつ取得
COLLECT_KEYWORDS=Nintendo Switch,プレイステーション5,ポケモンカード,ワイヤレスイヤホン,美容家電,炊飯器,掃除機,ゲームソフト,フィギュア,レゴ
# Yahoo!ショッピングのジャンルID (任意。カンマ区切り)
COLLECT_YAHOO_GENRES=
# キーワード/ジャンルごとの取得ページ数 (Yahoo は 1ページ50件)
COLLECT_PAGES=3

# === 利益計算パラメータ ===
# Amazon 販売手数料 (カテゴリから料率を推定できない場合のデフォルト。10%)
AMAZON_REFERRAL_FEE_RATE=0.10
# FBA 配送代行料の概算 (円。商品サイズで変動するが単純化)
AMAZON_FBA_FEE=500
# Amazon 手数料への消費税率
AMAZON_FEE_TAX_RATE=0.10
# FBA 納品送料の概算 (円/個)
AMAZON_INBOUND_COST=200
# 楽天 販売手数料 (出店プランで変動。デフォルト 10%)
RAKUTEN_FEE_RATE=0.10
# Yahoo!ショッピング 販売手数料 (ストアポイント原資等含む概算)
YAHOO_FEE_RATE=0.08
# 送料の概算 (円)
SHIPPING_COST=600
# 利益の最低閾値 (円)。これ以上の商品だけ抽出
MIN_PROFIT=500
# 利益率の最低閾値 (0-1)。これ以上の商品だけ抽出
MIN_PROFIT_RATE=0.15

# === 入出力 ===
INPUT_CSV_DIR=data/input
OUTPUT_DIR=data/output
COLLECTED_DIR=data/collected
