# Amazon Seller Analytics - 環境変数設定例
# このファイルを .env にコピーして実際の値を設定してください
# cp .env.example .env

# =============================================
# Amazon セラー情報
# =============================================
AMAZON_SELLER_ID=A2B1UA7OXUW3IW
AMAZON_MARKETPLACE_ID=A1VC38T7YXB528   # 日本 JP

# =============================================
# Login with Amazon (LWA) 認証
# Seller Central > アプリと連携 > デベロッパーセントラルで取得
# =============================================
LWA_APP_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LWA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LWA_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# AWS IAM 認証 (SP-API用)
# IAMコンソールで専用ユーザーを作成して取得
# =============================================
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/SellerCentralRole
