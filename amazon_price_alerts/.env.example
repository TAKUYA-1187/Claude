# ===== Keepa API (必須) =====
# https://keepa.com/#!api で API プランを契約して発行 (トークン制・月額)
KEEPA_API_KEY=your-keepa-api-key

# ===== メール送信 (Gmail SMTP) =====
# Google アカウント → セキュリティ → 2段階認証 → アプリパスワード で16桁を発行
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-16chars

# 通知先 (カンマ区切りで複数可)。未設定なら不動産朝レポートと同じ宛先
# ALERT_EMAIL_TO=taku.ino.19811014@gmail.com

# ===== 抽出条件 (省略時はデフォルト値) =====
# MIN_DROP_PERCENT=30    # 30日平均からの下落率(%)がこれ以上
# MIN_DROP_YEN=1000      # 下落額(円)がこれ以上
# MIN_SELLERS=3          # 新品出品者数がこれ以上 (独占販売を除外)
# MIN_PRICE=1500         # 現在価格の下限
# MAX_PRICE=300000       # 現在価格の上限
# MAX_SALES_RANK=80000   # 売れ筋ランキング上限
# ALERT_TTL_HOURS=72     # 同一ASINの再通知抑制時間
# MAX_ALERTS_PER_RUN=30  # 1回の実行で通知する最大件数
