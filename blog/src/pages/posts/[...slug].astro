---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';
import { hasActiveAffiliate } from '../../lib/affiliate-links';
import { noteProduct } from '../../notes';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, scripts } = post.data;
// 提携済みのアフィリエイトリンクを含む記事は、frontmatter の指定がなくてもPR表記を出す
const pr = post.data.pr || hasActiveAffiliate(post.body ?? '');
const note = noteProduct(post.data.note);
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Tokyo' });
const url = new URL(`/posts/${post.id}/`, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: new URL('/about/', Astro.site).toString() },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: url,
};
---

<Base title={title} description={description} type="article" jsonLd={jsonLd} scripts={scripts}>
  <article>
    <div class="meta">
      公開 <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      {updatedDate && <> ／ 更新 <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>}
    </div>
    <h1>{title}</h1>
    {pr && <p class="pr-notice">本記事はプロモーション（アフィリエイト広告）を含みます。</p>}
    {toc.length > 2 && (
      <details class="toc" open>
        <summary>目次</summary>
        <ol>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </details>
    )}
    {/* post-body の中身が WordPress に送る本文（wordpress/build_wp.py が切り出す。PR表記はそちらで先頭に付け直す） */}
    <div class="post-body">
      <div class="prose">
        <Content />
      </div>
      {note && (
        <aside class="note-cta">
          <p class="note-cta-label">運営者が note で配布しているシート</p>
          <p class="note-cta-title">{note.title}</p>
          <p>{note.pitch}</p>
          <ul>
            {note.includes.map((item) => <li>{item}</li>)}
          </ul>
          <a class="note-cta-button" href={note.url}>
            note で中身を見る{note.price > 0 ? `（${note.price.toLocaleString('ja-JP')}円）` : '（無料）'}
          </a>
        </aside>
      )}
    </div>
    <aside class="author-box">
      <strong>この記事を書いた人：{SITE.author}</strong>
      {SITE.authorBio}
      <div><a href="/about/">運営者情報を見る</a></div>
    </aside>
  </article>
</Base>
