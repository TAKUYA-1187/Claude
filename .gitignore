__pycache__/
*.pyc

# BGM Studio の生成物。本編MP4とWAVマスターは巨大なのでコミットしない。
# `python3 render_bgm.py` で再生成できる (シード固定なので完全に再現される)。
out/audio/
out/video/
out/visual/
out/tmp/

# Shorts 生成中の一時オーバーレイ画像
out/shorts/.overlay_*.png
# 歌もの。WAV/MP4 は巨大なのでコミットしない (render_songs.py で再現できる)
out/songs/*.wav
out/songs/*.mp4
out/songs/tmp/

# 投稿用にまとめたZIP (動画を含み巨大。再生成できるのでコミットしない)
out/upload/
out/listen/
out/for_gpt/*.mp3
samples/

samples/

# 無圧縮マスター (WAV) は同じ中身の FLAC をコミットしているので入れない。make_orig01.py で再生成できる
out/release_*/*.wav
out/release_2026-11-08b/*.zip
out/release_2026-11-09/*.zip
