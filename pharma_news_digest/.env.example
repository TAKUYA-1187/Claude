# === 送信元 設定（Gmail か iCloud のどちらか）===
# 発行した「アプリパスワード」を SENDER_APP_PASSWORD に設定（通常のログインパスワード不可）。
#
# ▼ Gmail を送信元にする場合（既定）
#   Google アカウント → セキュリティ → 2段階認証 → アプリパスワード（16桁）
SENDER_EMAIL=taku.ino.19811014@gmail.com
SENDER_APP_PASSWORD=your-app-password-16chars
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
#
# ▼ iCloud を送信元にする場合は上を消して以下を使う
#   appleid.apple.com → サインインとセキュリティ → App用パスワード
# SENDER_EMAIL=takuya0.0@icloud.com
# SENDER_APP_PASSWORD=your-app-specific-password
# SMTP_HOST=smtp.mail.me.com
# SMTP_PORT=587

# === 配信先（カンマ区切り。未設定なら既定の 1 アドレス）===
RECIPIENTS=takuya.inoue@novartis.com

# === 任意設定 ===
# PubMed のレート制限を緩和したい場合のみ（NCBI で無料発行）
NCBI_API_KEY=
# 収集ウィンドウの調整
NEWS_LOOKBACK_HOURS=30
PAPER_LOOKBACK_DAYS=14
MAX_ITEMS_PER_SECTION=12
