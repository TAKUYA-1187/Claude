# === 送信元 Gmail 設定 ===
# Google アカウント → セキュリティ → 2段階認証 → アプリパスワード で発行した
# 16 桁のパスワードを SENDER_APP_PASSWORD に設定してください（通常のログインパスワード不可）。
SENDER_EMAIL=your-sender@gmail.com
SENDER_APP_PASSWORD=your-app-password-16chars

# === 配信先（カンマ区切り。未設定なら担当者の 2 アドレスが既定）===
RECIPIENTS=taku.ino.19811014@gmail.com,takuya.inoue@novartis.com

# === SMTP（通常は変更不要）===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# === 任意設定 ===
# PubMed のレート制限を緩和したい場合のみ（NCBI で無料発行）
NCBI_API_KEY=
# 収集ウィンドウの調整
NEWS_LOOKBACK_HOURS=30
PAPER_LOOKBACK_DAYS=14
MAX_ITEMS_PER_SECTION=12
